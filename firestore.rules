rules_version = '2';

// Each visitor gets their own document at biltong/{uid}, where uid is their
// Firebase Auth user id. The app signs people in with Firebase's passwordless
// email-link auth (see sendSignInLink/completeSignInFromLink in index.html)
// — a real email, no password. These rules make sure a signed-in visitor can
// only ever read/write their own document, never anyone else's.

service cloud.firestore {
  match /databases/{database}/documents {
    match /biltong/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
    // Everything else stays closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
